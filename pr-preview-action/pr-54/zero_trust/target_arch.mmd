flowchart LR
    caller["Human / CI / tenant VM"]
    subgraph iam["Keystone (IAM)"]
        op["Who: OAuth2 / OIDC provider<br/>short-lived scope-less JWT"]
        authz["What: /v4/authz/check<br/>grants, roles, permissions"]
    end
    svc["OpenStack service<br/>+ policy engine"]
    spire["SPIRE<br/>(SVIDs)"]
    caller -->|"1. login: who"| op
    caller ==>|"2. Bearer JWT<br/>+ OpenStack-Target: where"| svc
    svc -->|"3. check(sub, op, target): what"| authz
    spire -.->|"mTLS identity"| svc
    spire -.->|"mTLS identity"| iam
